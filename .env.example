# Copy to .env and fill in. Nothing here is required for the analysis itself.

# Optional outbound proxy for the vendored collectors (comma-separated).
# Leave blank to use your own connection. Do not use this to escalate past a block.
CLOAK_PROXY=

# Allow the vendored collectors to launch a local browser to mint a session
# (required for Walmart store scoping and for first-time Target/Instacart sessions).
ALLOW_BROWSER_WARM=1

# Collection pacing for this project's wrappers (collectors/common.py).
GS_MIN_INTERVAL_SECONDS=2.0
GS_MAX_RETRIES=2

# Nominatim requires an identifying user agent (contact email recommended).
GS_NOMINATIM_USER_AGENT=groceryStatistics-research

# Census API key for the ACS covariates (Module C). Free:
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=6ccc94ff30af8dbd8a10ff860076b644d81e8064


# Kroger Public API (developer.kroger.com), client-credentials app.
# Credentials are environment-specific: production = api.kroger.com.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
